        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|filename|language|variant|showHeader|copyable|lineNumbers|highlight|maxHeight|key|ref|className|style|children)$/]",
